# Drift Architecture

direction: right

CLI_User: {
  shape: person
  label: "CLI User"
}

Browser_User: {
  shape: person
  label: "Browser User"
}

Dynamic_Data: {
  shape: stored_data
  label: "Dynamic Data (JSON/API)"
}

drift_cli: {
  label: "src/cli"
  shape: rectangle
}

drift_wasm: {
  label: "src/wasm"
  shape: rectangle
}

Preprocessor: {
  label: "src/preprocessor"
  shape: class
}

Renderer: {
  label: "src/renderer"
  shape: class
}

D2Core: {
  label: "third_party/d2"
  shape: package
}

SVG: {
  shape: document
  label: "Output.svg"
}

CLI_User -> drift_cli: "Executes"
Browser_User -> drift_wasm: "Calls"
Dynamic_Data -> drift_wasm: "Provides"

drift_cli -> Preprocessor: "Uses"
drift_cli -> Renderer: "Uses"

drift_wasm -> Preprocessor: "Uses"
drift_wasm -> Renderer: "Uses"

Preprocessor -> D2Core: "Generates D2 AST"
Renderer -> D2Core: "Renders AST"

D2Core -> SVG: "Produces"
